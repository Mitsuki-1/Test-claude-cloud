# Настройки для хостинга AIRNET (cPanel, Apache/LiteSpeed). GitHub Pages этот файл игнорирует.
# Перенаправление на https включается в cPanel: Домены → «Принудительное перенаправление HTTPS»
# (после того как AutoSSL выпустит сертификат для домена).

Options -Indexes
DirectoryIndex index.html

AddType video/mp4 .mp4
AddType image/svg+xml .svg
AddDefaultCharset UTF-8
AddCharset UTF-8 .js .css .html

# Служебный файл выкладки из GitHub — не показывать посетителям
<Files ".ftp-deploy-sync-state.json">
  Require all denied
</Files>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css text/javascript application/javascript application/json image/svg+xml
</IfModule>

# Кэш в браузере. При выкладке scripts/stamp_assets.py дописывает к css/js в HTML версию (?v=<хэш файла>),
# поэтому стили и скрипты можно хранить долго — после изменения у них новый адрес.
# Сами страницы браузер каждый раз сверяет с сервером, чтобы сразу видеть новые версии файлов.
<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 10 minutes"
  ExpiresByType text/html "access plus 0 seconds"
  ExpiresByType image/jpeg "access plus 30 days"
  ExpiresByType image/png "access plus 7 days"
  ExpiresByType image/svg+xml "access plus 7 days"
  ExpiresByType video/mp4 "access plus 30 days"
  ExpiresByType text/css "access plus 30 days"
  ExpiresByType application/javascript "access plus 30 days"
  ExpiresByType text/javascript "access plus 30 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
</IfModule>
